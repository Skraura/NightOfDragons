rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dev');
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /dragons/{dragonId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /nestingSpots/{spotId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.visibility == 'global' ||
        resource.data.author_id == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || resource.data.author_id == request.auth.uid);
      allow delete: if request.auth != null && (isAdmin() || resource.data.author_id == request.auth.uid);
    }

    match /versionNotes/{noteId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
