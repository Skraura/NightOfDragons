{
  "name": "dod-tracker",
  "version": "1.3.0",
  "description": "DoD Tracker v8.3.0 \u2014 New Nest-based Lineage Graph",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "family-chart": "^0.9.0",
    "fs-extra": "^11.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.33.2",
    "uuid": "^9.0.0",
    "firebase": "^11.6.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dodtracker.app",
    "productName": "DoD Tracker",
    "copyright": "Copyright \u00a9 2024",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "electron/tessdata",
        "to": "tessdata",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "training-data",
        "to": "training-data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bundled-calibration.json",
        "to": "bundled-calibration.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DoD Tracker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "description": "Day of Dragons dragon tracker"
    },
    "publish": null,
    "mac": {
      "icon": "assets/icon512.png",
      "category": "public.app-category.utilities"
    }
  },
  "author": "DoD Tracker"
}